map $uri $asset_cache {
    default "public, max-age=0, must-revalidate";
    ~^/api/ "no-store";
    ~^/assets/.*\.(js|css)$ "public, max-age=31536000, immutable";
    ~^/assets/images/ "public, max-age=86400";
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    absolute_redirect off;
    charset utf-8;

    include /etc/nginx/security-headers.conf;
    add_header Cache-Control $asset_cache always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json application/xml text/xml image/svg+xml;

    # Serve the canonical commercial paths without a directory redirect.
    location ~ ^/(websites|aplicativos|sistemas|ai-solutions|reestruturacao|portifolio|contato)$ {
        try_files $uri/index.html =404;
    }

    # Keep the public contact service same-origin for the browser.
    location = /api/contact {
        if ($request_method != POST) { return 405; }
        if ($http_origin != "https://byaskora.com") { return 403; }
        if ($http_x_askora_request != "1") { return 403; }
        client_max_body_size 16k;
        proxy_pass https://askora.com.br/api/public/contact;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host askora.com.br;
        proxy_set_header Origin "";
        proxy_set_header Sec-Fetch-Site "";
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header Referer "";
        proxy_read_timeout 20s;
        proxy_connect_timeout 5s;
    }

    location = /api/ai/chat {
        client_max_body_size 40k;
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 25s;
        proxy_connect_timeout 3s;
        proxy_buffering off;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Normalize the alternate document URL, preserving query parameters.
    location = /index.html {
        if ($request_uri ~ "^/index\.html") { return 301 /$is_args$args; }
    }

    location ~ /\. {
        deny all;
    }
}
