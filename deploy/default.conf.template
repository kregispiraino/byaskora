map $uri $asset_cache {
    default "public, max-age=0, must-revalidate";
    ~^/assets/.*\.(js|css)$ "public, max-age=31536000, immutable";
    ~^/assets/images/ "public, max-age=86400";
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    absolute_redirect off;
    charset utf-8;

    include /etc/nginx/security-headers.conf;
    add_header Cache-Control $asset_cache always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json application/xml text/xml image/svg+xml;

    location / {
        try_files $uri $uri/ =404;
    }

    # Normalize the alternate document URL, preserving query parameters.
    location = /index.html {
        if ($request_uri ~ "^/index\.html") { return 301 /$is_args$args; }
    }

    location ~ /\. {
        deny all;
    }
}
